# Copy this file to .env. A machine has a single .env, and Compose reads it for
# variable interpolation and env_file. Use ONE section below.

# =============================================================================
# DEVELOPMENT (default)
# =============================================================================
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
COMPOSE_PATH_SEPARATOR=:

SECRET_KEY=dev-secret-key-change-me
JWT_SIGNING_KEY=dev-jwt-signing-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web
DATABASE_URL=postgres://ticketing:ticketing@localhost:5432/ticketing
DJANGO_SETTINGS_MODULE=config.settings.dev
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
METRICS_TOKEN=dev-metrics-token
NUM_PROXIES=0
MAX_REQUEST_BODY_BYTES=65536
MAX_UPLOAD_BODY_BYTES=11534336
WIDGET_POW_DIFFICULTY=0
STORAGE_BACKEND=local
DOWNLOAD_URL_TTL_SECONDS=300
S3_BUCKET_NAME=ticketing
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION_NAME=us-east-1

# =============================================================================
# PRODUCTION
# Delete the DEVELOPMENT section above first, then uncomment every line below and
# replace each change-me value. Do not keep both: the same keys appear in each.
# =============================================================================
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# COMPOSE_PATH_SEPARATOR=:

# SECRET_KEY=change-me-to-a-long-random-string
# JWT_SIGNING_KEY=change-me-to-a-different-long-random-string
# METRICS_TOKEN=change-me-to-a-third-long-random-string

# DEBUG=False
# DJANGO_SETTINGS_MODULE=config.settings.prod
# ALLOWED_HOSTS=localhost,127.0.0.1,web
# CSRF_TRUSTED_ORIGINS=http://localhost:8000
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# POSTGRES_USER=ticketing
# POSTGRES_PASSWORD=change-me-to-a-database-password
# POSTGRES_DB=ticketing
# DATABASE_URL=postgres://ticketing:change-me-to-a-database-password@db:5432/ticketing

# REDIS_URL=redis://redis:6379/0
# LOG_LEVEL=INFO

# Set to true only behind an HTTPS reverse proxy. The local stack is plain HTTP.
# SECURE_SSL_REDIRECT=False
# Host address the app is published on. Keeping the loopback address here means only a
# local reverse proxy can reach it.
# WEB_PORT=127.0.0.1:8000
# Number of reverse proxies in front of the app. Production refuses to start without it.
# Set 0 only when clients reach the app directly, and then also set ALLOW_ZERO_PROXIES=true.
# NUM_PROXIES=1
# ALLOW_ZERO_PROXIES=false
# Default body limit for JSON and form requests, and the larger limit for multipart uploads.
# Set the proxy limit (client_max_body_size) to the upload limit to match.
# MAX_REQUEST_BODY_BYTES=65536
# MAX_UPLOAD_BODY_BYTES=11534336
# Proof of work for new widget conversations. 16 bits is a reasonable production default.
# WIDGET_POW_DIFFICULTY=16

# local keeps uploaded files on the media volume. Set to s3 and fill in the
# S3_* values below to use an S3-compatible bucket instead.
# STORAGE_BACKEND=local
# DOWNLOAD_URL_TTL_SECONDS=300
# S3_BUCKET_NAME=ticketing
# S3_ACCESS_KEY=change-me
# S3_SECRET_KEY=change-me
# S3_ENDPOINT_URL=https://s3.example.com
# S3_PUBLIC_ENDPOINT_URL=https://s3.example.com
# S3_REGION_NAME=us-east-1

# Optional build mirrors that work from inside Iran. Either export them in the
# shell or list them here.
# PYTHON_IMAGE=docker.arvancloud.ir/python:3.12-slim
# PIP_INDEX_URL=https://mirror-pypi.runflare.com/simple
