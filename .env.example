# Copy this file to .env. A machine has a single .env, and Compose reads it for
# variable interpolation and env_file. Use ONE section below.

# =============================================================================
# DEVELOPMENT (default)
# =============================================================================
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
COMPOSE_PATH_SEPARATOR=:

SECRET_KEY=dev-secret-key-change-me
JWT_SIGNING_KEY=dev-jwt-signing-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web
DATABASE_URL=postgres://ticketing:ticketing@localhost:5432/ticketing
DJANGO_SETTINGS_MODULE=config.settings.dev
CACHE_REDIS_URL=redis://localhost:6379/0
BROKER_REDIS_URL=redis://localhost:6379/1
CHANNEL_REDIS_URL=redis://localhost:6379/2
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
METRICS_TOKEN=dev-metrics-token
NUM_PROXIES=0
MAX_REQUEST_BODY_BYTES=65536
MAX_UPLOAD_BODY_BYTES=11534336
WIDGET_POW_DIFFICULTY=0
STORAGE_BACKEND=local
DOWNLOAD_URL_TTL_SECONDS=300
S3_BUCKET_NAME=ticketing
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION_NAME=us-east-1

# =============================================================================
# PRODUCTION
# Delete the DEVELOPMENT section above first, then uncomment every line below and
# replace each change-me value. Do not keep both: the same keys appear in each.
# =============================================================================
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# COMPOSE_PATH_SEPARATOR=:

# Public host name Caddy serves and gets a certificate for (ports 80 and 443 must reach
# this host). Compose derives ALLOWED_HOSTS (the host name) and CSRF_TRUSTED_ORIGINS
# (https://<host>) from it, so they are not set here.
# DOMAIN=support.example.com
# Space-separated IPs or CIDRs allowed to reach /admin/. Everyone else gets 403.
# ADMIN_ALLOWED_IPS=203.0.113.7 198.51.100.0/24
# Set when STORAGE_BACKEND=s3: the origin of S3_PUBLIC_ENDPOINT_URL, so the frontend CSP lets the browser load files from it.
# MEDIA_ORIGIN=https://s3.example.com
# Signs the frontend's role cookie. At least 32 random characters.
# FRONTEND_SESSION_SECRET=change-me-to-a-fourth-long-random-string

# SECRET_KEY=change-me-to-a-long-random-string
# JWT_SIGNING_KEY=change-me-to-a-different-long-random-string
# METRICS_TOKEN=change-me-to-a-third-long-random-string
# Off by default in production. Set True only to serve /api/docs/ and /api/schema/ to admins
# with a bearer token.
# API_DOCS_ENABLED=False

# DEBUG=False
# DJANGO_SETTINGS_MODULE=config.settings.prod
# CORS_ALLOWED_ORIGINS defaults to https://<DOMAIN>. Set it only if the frontend is served
# from other origins (comma-separated).
# CORS_ALLOWED_ORIGINS=https://app.example.com

# POSTGRES_USER=ticketing
# POSTGRES_PASSWORD=change-me-to-a-database-password
# POSTGRES_DB=ticketing
# DATABASE_URL=postgres://ticketing:change-me-to-a-database-password@db:5432/ticketing

# The app reaches the cache and channel layer on the redis service, and Celery on the broker
# service. Compose sets these in the container environment; set them here only for a host run.
# CACHE_REDIS_URL=redis://redis:6379/0
# BROKER_REDIS_URL=redis://broker:6379/1
# CHANNEL_REDIS_URL=redis://redis:6379/2
# Memory limit for the cache Redis. Once it is full, the least recently used keys with a TTL
# are evicted. Size it to the throttle, presence and ticket keys plus channel messages.
# REDIS_CACHE_MAXMEMORY=256mb
# LOG_LEVEL=INFO

# Caddy terminates TLS and sends X-Forwarded-Proto, so the app redirects any plain-HTTP request.
# /health/, /ready/ and /metrics/ are exempt. Use False only for a plain-HTTP test stack.
# SECURE_SSL_REDIRECT=True
# Number of reverse proxies in front of the app. Production refuses to start without it.
# Set 0 only when clients reach the app directly, and then also set ALLOW_ZERO_PROXIES=true.
# NUM_PROXIES=1
# ALLOW_ZERO_PROXIES=false
# Default body limit for JSON and form requests, and the larger limit for multipart uploads.
# Set the proxy limit (client_max_body_size) to the upload limit to match.
# MAX_REQUEST_BODY_BYTES=65536
# MAX_UPLOAD_BODY_BYTES=11534336
# Proof of work for new widget conversations. 16 bits is a reasonable production default.
# WIDGET_POW_DIFFICULTY=18

# local keeps uploaded files on the media volume. Set to s3 and fill in the
# S3_* values below to use an S3-compatible bucket instead.
# STORAGE_BACKEND=local
# DOWNLOAD_URL_TTL_SECONDS=300
# S3_BUCKET_NAME=ticketing
# S3_ACCESS_KEY=change-me
# S3_SECRET_KEY=change-me
# S3_ENDPOINT_URL=https://s3.example.com
# S3_PUBLIC_ENDPOINT_URL=https://s3.example.com
# S3_REGION_NAME=us-east-1

# Optional build mirrors that work from inside Iran. Either export them in the
# shell or list them here.
# PYTHON_IMAGE=docker.arvancloud.ir/python:3.12-slim
# NODE_IMAGE=docker.arvancloud.ir/node:24-bookworm-slim
# NPM_REGISTRY=https://registry.npmmirror.com
# PIP_INDEX_URL=https://mirror-pypi.runflare.com/simple
