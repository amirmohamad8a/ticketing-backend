{$DOMAIN} {
	log

	request_body {
		max_size 11MiB
	}

	@metrics path /metrics /metrics/*
	handle @metrics {
		respond 404
	}

	@admin_blocked {
		path /admin /admin/*
		not remote_ip {$ADMIN_ALLOWED_IPS:127.0.0.1}
	}
	handle @admin_blocked {
		respond 403
	}

	@django path /api/* /ws/* /admin /admin/* /static/*
	handle @django {
		reverse_proxy {
			dynamic a web 8000
		}
	}

	handle {
		reverse_proxy frontend:3000
	}
}
